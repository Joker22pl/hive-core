# HIVE Core — environment variables example
# ---------------------------------------------------------------------
# Copy this file to `.env` and edit values for your environment.
# NEVER commit the real `.env` file.
# ---------------------------------------------------------------------

# Python logging level for the HIVE Core package.
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
HIVE_LOG_LEVEL=INFO

# SQLite registry URL (H1+).
# Default: sqlite:///${XDG_DATA_HOME:-~/.local/share}/hive/hive.db
# Set to sqlite:///:memory: for tests / ephemeral state.
# HIVE_DB_URL=sqlite:////var/lib/hive/hive.db

# Default lock store backend for the CLI.
# H0: "memory" (default) or "json"
# H1+: "memory" | "json" | "sqlite"
HIVE_LOCK_STORE=memory

# JsonLockStore path (only used when HIVE_LOCK_STORE=json).
# HIVE_LOCK_JSON_PATH=/var/lib/hive/locks.json

# SQLite lock store path (H1+).
# HIVE_LOCK_SQLITE_PATH=/var/lib/hive/locks.db

# HIVE-IO controller endpoint (H2+).
# Either a USB CDC device path or a network endpoint (H7+).
# HIVE_IO_ENDPOINT=/dev/ttyACM0

# HIVE-IO heartbeat interval (milliseconds).
HIVE_IO_HEARTBEAT_MS=200

# HIVE-IO heartbeat timeout (milliseconds) — triggers safe_state.
HIVE_IO_HEARTBEAT_TIMEOUT_MS=1000

# Path to the HIVE device registry (overrides the default registry/devices).
# HIVE_REGISTRY_DIR=/etc/hive/registry

# Path to the HIVE artifact store (H3+).
# HIVE_ARTIFACT_DIR=/var/lib/hive/artifacts

# Operator identity for HARE (used as lock owner when not specified).
HIVE_OPERATOR=hare

# GitHub token (H5+; used for evidence upload to gh-pages).
# Store in a real secret manager, not in this file.
# GITHUB_TOKEN=

# ----------------------------------------------------------------------------
# Variables used by tests / CI only
# ----------------------------------------------------------------------------

# Coverage fail-under threshold (CI only).
# HIVE_CI_COV_FAIL_UNDER=90
