{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Joker22pl/hive-core/schemas/verification-profile.schema.json",
  "title": "HIVE Verification Profile",
  "description": "Deklaratywny profil weryfikacyjny (sekwencja kroków do wykonania na urządzeniu).",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "target_type", "preconditions", "steps", "success", "failure"],
  "properties": {
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "target_type": {
      "type": "string",
      "description": "Typ urządzenia docelowego (np. esp32-s3-pico, raspberry-pi-pico, linux_host)."
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "device_match_confirmed",
          "device_locked_by_self",
          "motor_enable_off",
          "estop_inactive",
          "artifact_compatible",
          "artifact_known_good",
          "io_controller_connected"
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string"},
          "type": {
            "type": "string",
            "enum": [
              "adapter_call",
              "serial_observe",
              "serial_collect",
              "assertion",
              "delay",
              "script",
              "parallel"
            ]
          },
          "description": {"type": "string"},
          "timeout_s": {"type": "number", "minimum": 0.1},
          "on_failure": {
            "type": "string",
            "enum": ["abort", "continue", "classify_failure"],
            "default": "abort"
          },
          "params": {"type": "object", "additionalProperties": true},
          "steps": {
            "type": "array",
            "description": "Pod-kroki (tylko dla type=parallel).",
            "items": {"type": "object"}
          }
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all_steps_passed": {"type": "boolean", "default": true},
        "collect_evidence": {"type": "boolean", "default": true},
        "mark_artifact_known_good": {"type": "boolean", "default": false}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collect_evidence": {"type": "boolean", "default": true},
        "attempt_recovery": {"type": "boolean", "default": false},
        "rollback_to_known_good": {"type": "boolean", "default": false},
        "max_recovery_attempts": {"type": "integer", "minimum": 0, "maximum": 10, "default": 0}
      }
    }
  }
}
